# Скопируйте в backend/.env и заполните нужное. Все переменные необязательны.

# --- Django ---
# DEBUG=1
# SECRET_KEY=               # если пусто, ключ создаётся в backend/.secret_key
# ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://labs.example.kz
# HTTPS=1                   # за обратным прокси с TLS
# TIME_ZONE=Asia/Almaty

# --- База данных: без этих строк используется SQLite (backend/aiedu.sqlite3) ---
# DATABASE_NAME=aiedu
# DATABASE_USER=aiedu
# DATABASE_PASSWORD=aiedu
# DATABASE_HOST=localhost
# DATABASE_PORT=5432

# --- Роли (логины через запятую). Первый зарегистрированный пользователь становится администратором ---
# FIRST_USER_ADMIN=1
# VIRTUAL_LABS_ADMIN_LOGINS=admin
# VIRTUAL_LABS_TUTOR_LOGINS=tutor1,tutor2

# --- Языковая модель. Удобнее подключать в интерфейсе: Администрирование → Модели ИИ ---
# VIRTUAL_LABS_AI_KIND=openai          # openai | gemini | anthropic | compatible
# VIRTUAL_LABS_AI_API_KEY=
# VIRTUAL_LABS_AI_MODEL=gpt-4o-mini
# VIRTUAL_LABS_AI_BASE_URL=            # для OpenAI-совместимых API (OpenRouter, DeepSeek)
# VIRTUAL_LABS_AI_TIMEOUT=120

# --- Озвучка (работы № 6 и № 12). Без ключа читает синтезатор браузера ---
# VIRTUAL_LABS_TTS_KIND=openai_tts     # openai_tts | elevenlabs
# VIRTUAL_LABS_TTS_API_KEY=
# VIRTUAL_LABS_TTS_MODEL=gpt-4o-mini-tts
# VIRTUAL_LABS_TTS_VOICE=alloy

# --- Резервные копии: python manage.py vl_backup [--every-hours 24] ---
# VIRTUAL_LABS_BACKUP_DIR=backups
# VIRTUAL_LABS_BACKUP_KEEP=14

# --- Поиск литературы: адрес для «вежливого» доступа к OpenAlex и Crossref ---
# VIRTUAL_LABS_CONTACT_EMAIL=

# --- LTI 1.3 (Moodle, Open edX, Canvas). Публичный адрес тренажёра ---
# VIRTUAL_LABS_LTI_TOOL_URL=https://labs.example.kz
# LTI_IN_IFRAME=1                      # если LMS открывает тренажёр во фрейме (нужен HTTPS=1)
